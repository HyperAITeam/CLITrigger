PORT=3000
AUTH_PASSWORD=                  # 선택 — 비우면 첫 접속 시 웹 UI 셋업 화면이 뜬다(이 컴퓨터에서만 설정 가능).
                                #        값이 있으면 1회만 사용 후 hash로 변환·저장됨.
SESSION_SECRET=
# 서버가 받는 주소. 기본 127.0.0.1 = 이 컴퓨터(+ Cloudflare 터널)만 접속 가능.
# 같은 네트워크의 다른 기기에서도 접속하려면 0.0.0.0 (비밀번호만이 방어선이 된다).
BIND_HOST=
# 서버가 응답할 추가 호스트 이름(쉼표 구분). localhost, IP 주소, 터널 호스트는 기본 허용.
ALLOWED_HOSTS=
# 이 서버 API를 브라우저에서 호출할 다른 출처(쉼표 구분). 기본은 같은 출처만 허용.
# 예: Vite 개발 서버를 프록시 없이 쓸 때 http://localhost:5173
CORS_ORIGIN=
TUNNEL_ENABLED=false
TUNNEL_NAME=
LOG_RETENTION_DAYS=30
